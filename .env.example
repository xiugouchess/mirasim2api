# Common settings: container suffix, optional SOCKS5 proxy, Web UI port, unified bridge port.
# MIRASIM_PROXY supports socks5://username:password@proxy.example.com:1080; empty means direct access.
DOCKER_NAME=
MIRASIM_PROXY=
MIRASIM_WEB_HOST_PORT=4939
MIRASIM_UNIFIED_HOST_PORT=12015

# Managed automatically by start.sh from https://mirasim.ai/.
MIRASIM_DMG_URL=
MIRASIM_IMAGE=

# Port publish switches. 1 = publish to host, 0 = do not publish.
# Default only publishes Web UI and Unified bridge.
MIRASIM_PUBLISH_WEB=1
MIRASIM_PUBLISH_UNIFIED=1
MIRASIM_PUBLISH_CODEX=0
MIRASIM_PUBLISH_CLAUDE=0

# Only configure host/external mappings here. Container internal ports are fixed:
# 4939 / 12015 / 12017 / 12018
# Equivalent to: docker -p HOST:HOST_PORT:CONTAINER_PORT

# Web UI: host HOST_PORT -> container 4939
MIRASIM_WEB_HOST=0.0.0.0

# Unified bridge: host HOST_PORT -> container 12015
# Claude base_url = http://host:12015
# Codex  base_url = http://host:12015/v1
MIRASIM_UNIFIED_HOST=127.0.0.1

# Codex dedicated bridge: host HOST_PORT -> container 12017
MIRASIM_CODEX_HOST=127.0.0.1
MIRASIM_CODEX_HOST_PORT=12017

# Claude dedicated bridge: host HOST_PORT -> container 12018
MIRASIM_CLAUDE_HOST=127.0.0.1
MIRASIM_CLAUDE_HOST_PORT=12018

MIRASIM_BRIDGE_ENABLED=1
MIRASIM_DISABLE_LOGIN_REFRESH=1

# API key for 12015/12017/12018 bridge ports. Change this if exposed publicly.
# Accepted headers: Authorization: Bearer <key>, x-api-key: <key>, api-key: <key>
MIRASIM_BRIDGE_API_KEY=password

MIRASIM_CODEX_BRIDGE_WARMUP=1
MIRASIM_CODEX_KEEP_WARM=1
MIRASIM_CODEX_BRIDGE_WAIT_MS=180000
MIRASIM_CODEX_DEFAULT_MODEL=kimi-k3
MIRASIM_CODEX_DEFAULT_EFFORT=low
